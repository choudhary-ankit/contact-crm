DATABASE_URL=postgres://crm:crm@localhost:5432/crm
PORT=3000
# "key:accountId" pairs, comma separated. Each key is scoped to exactly one account.
API_KEYS=demo-key:11111111-1111-4111-8111-111111111111,demo-key-2:22222222-2222-4222-8222-222222222222
RATE_LIMIT_PER_MIN=300
WRITE_RATE_LIMIT_PER_MIN=60
CORS_ORIGIN=http://localhost:5173
AUTO_MIGRATE=true
# CSV import / metrics (defaults shown)
IMPORT_WORKER_ENABLED=true
IMPORT_MAX_ROWS=50000
IMPORT_MAX_BYTES=5242880
IMPORT_CHUNK_SIZE=500
METRICS_CACHE_TTL_MS=30000
# Production (behind Render/another proxy): 1. Keep API_KEYS secret-ish: the key the frontend uses is public in the browser.
TRUST_PROXY=0
